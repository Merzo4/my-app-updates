                                                            <TextBlock Text="{Binding RootPath, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9.4" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                            <TextBlock Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
