                                <Border Width="38" Height="38" Background="#173A35" BorderBrush="#2A5F56" BorderThickness="1" CornerRadius="19" Margin="0,0,9,0"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
