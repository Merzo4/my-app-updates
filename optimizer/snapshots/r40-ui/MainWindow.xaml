                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,4,4,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Margin="0,0,6,0" Padding="10" CornerRadius="9">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#141B24"/><Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsLightRecommended}" Value="True"><Setter Property="Background" Value="#112923"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <StackPanel>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="LIGHT" FontSize="15" FontWeight="SemiBold"/><Border Grid.Column="1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource RecommendationBadge}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLightRecommended}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="РЕКОМЕНДУЕТСЯ" Foreground="{StaticResource Accent}" FontSize="9.4" FontWeight="Bold"/></Border></Grid>
                                                    <TextBlock Text="Лёгкая очистка Windows" Foreground="{StaticResource Accent}" FontSize="10.4" Margin="0,4,0,2"/>
                                                    <TextBlock Text="Безопасная оптимизация + Privacy SAFE: реклама, Activity History, Spotlight, tailored experiences и лишний consumer-контент." Foreground="{StaticResource TextMuted}" FontSize="9.9" TextWrapping="Wrap" MinHeight="38"/>
                                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LightProfileAvailableText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="9.9" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Command="{Binding SelectLightProfileCommand}" Content="Выбрать"/></Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Margin="0,0,6,0" Padding="10" CornerRadius="9">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#141B24"/><Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsStandardRecommended}" Value="True"><Setter Property="Background" Value="#112923"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <StackPanel>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="STANDARD" FontSize="15" FontWeight="SemiBold"/><Border Grid.Column="1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource RecommendationBadge}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStandardRecommended}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="РЕКОМЕНДУЕТСЯ" Foreground="{StaticResource Accent}" FontSize="9.4" FontWeight="Bold"/></Border></Grid>
                                                    <TextBlock Text="Оптимальный баланс" Foreground="{StaticResource Warning}" FontSize="10.4" Margin="0,4,0,2"/>
