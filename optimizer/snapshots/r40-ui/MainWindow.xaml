                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource TableActionButton}" Command="{Binding RestoreCommand}" Content="Вернуть"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
