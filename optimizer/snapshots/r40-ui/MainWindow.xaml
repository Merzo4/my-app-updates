                                        <TextBlock Grid.Column="1" Text="Ручной режим: известные опасные сборочные твики видны для диагностики, но Apply у них заблокирован." Foreground="{StaticResource TextMuted}" FontSize="9.8" VerticalAlignment="Center" TextAlignment="Right"/>
