                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#111720" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="0,0,4,0"><TextBlock Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="9.4"/></Border><Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="5,2"><TextBlock Text="{Binding Risk, Mode=OneWay}" Foreground="{Binding RiskColor, Mode=OneWay}" FontSize="9.4" FontWeight="Bold"/></Border></StackPanel>
                                                            <Grid Grid.Column="3" Margin="7,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource TablePrimaryButton}" Command="{Binding ApplyCommand}" Content="Применить"/><Button Grid.Column="2" Style="{StaticResource TableActionButton}" Command="{Binding RestoreCommand}" Content="Вернуть"/></Grid>
