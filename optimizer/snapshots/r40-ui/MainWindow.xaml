                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="92"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Проверка и оптимизация"/>
                            <TextBlock Text="Сначала Merzo изучит Windows и уже потом предложит подходящий уровень оптимизации." Foreground="{StaticResource TextMuted}" FontSize="10.8"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,5,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource PresetCardBorder}" Margin="0,0,7,0" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Сначала проверим Windows" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Без изменений системы. Merzo сравнит текущие настройки с большой базой, распознает уже применённые твики сборки и рассчитает, что действительно осталось полезного." Foreground="{StaticResource TextSecondary}" FontSize="10.7" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" Style="{StaticResource ScanOrbButton}" Command="{Binding RunDeepOptimizationScanCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Запустить глубокую проверку">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="25" HorizontalAlignment="Center"/>
                                            <TextBlock Text="ПРОВЕРИТЬ" FontSize="10.4" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Row="2">
                                        <ProgressBar Value="{Binding DeepScanProgress, Mode=OneWay}" Maximum="100" Height="4"/>
                                        <TextBlock Text="{Binding DeepScanStatusText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10.2" TextAlignment="Center" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource PresetCardBorder}" Margin="0" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Что проверит Merzo" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="8 этапов · ничего не применяется" Foreground="{StaticResource Accent}" FontSize="10.2" Margin="0,2,0,7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="1  Windows, build и оборудование" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="2  База оптимизаций и сборочных твиков" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="3  Автозагрузка" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="4  Очистка и размеры кэшей" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="5  Службы и Scheduled Tasks" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="6  Питание" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="7  Appx / Debloat" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,0,0,5"/>
                                        <TextBlock Text="8  Итог и персональная рекомендация" Foreground="{StaticResource TextSecondary}" FontSize="10.4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Row="2" Background="#101820" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="9,6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Ход проверки" FontSize="11.2" FontWeight="SemiBold"/>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding DeepScanSteps}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource TextMuted}" FontSize="9.9" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- AFTER SCAN: recommendation first, controls second -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOptimizationScanResults}" Value="True">
