                                                                <TextBlock Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="9.9" TextWrapping="Wrap"/>
                                                                <TextBlock Text="Путь" Foreground="{StaticResource Accent}" FontSize="9.5" FontWeight="SemiBold" Margin="0,5,0,1"/>
                                                                <TextBlock Text="{Binding RootPath, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="9.5" TextWrapping="Wrap"/>
                                                                <TextBlock Text="Перед удалением создаются ZIP-backup и Snapshot; занятые/защищённые файлы пропускаются." Foreground="{StaticResource TextMuted}" FontSize="9.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
