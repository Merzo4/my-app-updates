                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Выбранное" Style="{StaticResource SubTabItem}">
                                <Grid Margin="0,4,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#111A20" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SelectedTweaksText, Mode=OneWay}" FontWeight="SemiBold" FontSize="10.7" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource CompactSecondaryButton}" Command="{Binding ClearTweakSelectionCommand}" Content="Очистить" Margin="0,0,6,0"/><Button Grid.Column="2" Style="{StaticResource CompactPrimaryButton}" Command="{Binding ApplySelectedTweaksCommand}" Content="Применить набор"/></Grid></Border>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><ItemsControl ItemsSource="{Binding SelectedTweaks}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource SelectedListItemBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="11.2" FontWeight="SemiBold"/><TextBlock Text="{Binding CategoryDisplay, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="9.7" Margin="0,1,0,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#111720" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="0,0,4,0"><TextBlock Text="{Binding StateText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="9.4"/></Border><Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="5,2"><TextBlock Text="{Binding Risk, Mode=OneWay}" Foreground="{Binding RiskColor, Mode=OneWay}" FontSize="9.4" FontWeight="Bold"/></Border></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Ход работы" Style="{StaticResource SubTabItem}">
