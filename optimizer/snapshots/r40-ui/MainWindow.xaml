                                    <DataGridTextColumn Header="Risk" Binding="{Binding Risk, Mode=OneWay}" Width="66"/>
                                    <DataGridTextColumn Header="Рекомендация" Binding="{Binding Recommendation, Mode=OneWay}" Width="*"/>
                                    <DataGridTemplateColumn Header="" Width="78">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource TableActionButton}" Command="{Binding DisableCommand}" Content="Отключить" MinWidth="62"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="72">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource TableActionButton}" Command="{Binding RestoreCommand}" Content="Вернуть" MinWidth="58"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- R38: Gaming Boost / Extreme Performance -->
            <TabItem>
                <Grid Margin="11,8,11,9">
