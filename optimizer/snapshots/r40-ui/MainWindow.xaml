                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SnapshotSummaryText, Mode=OneWay}" FontWeight="SemiBold" FontSize="11.2"/>
                                <TextBlock Text="{Binding SnapshotDirectory, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Snapshots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}" Height="52" Margin="0,0,0,5" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CreatedText, Mode=OneWay}" FontSize="10.4" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding ShortId, Mode=OneWay}" FontFamily="Consolas" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="11.2" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding EntryCountText, Mode=OneWay}" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="10.4" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" MinHeight="24" Padding="6,3" FontSize="10.4" Content="Restore" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Logs -->
            <TabItem>
                <Grid Margin="11,8,11,9">
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Style="{StaticResource PageTitle}" Text="Журнал и архитектура"/><TextBlock Text="Audit trail работает уже с первого сканирования" Foreground="{StaticResource TextMuted}" FontSize="11.2"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0" Padding="11">
                            <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="ПАПКА ЛОГОВ"/><TextBlock Text="{Binding LogDirectory, Mode=OneWay}" FontFamily="Consolas" FontSize="11.2" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{StaticResource TextSecondary}"/><Separator Margin="0,10,0,9"/><TextBlock Text="Stage 2 уже пишет старое/новое значение для твиков и Restore, статус операции, snapshot ID и ошибки." Foreground="{StaticResource TextMuted}" FontSize="11.2" TextWrapping="Wrap"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0" Padding="11">
                            <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="ARCHITECTURE"/><TextBlock Text="UI → Core → Windows" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,7"/><TextBlock Text="Core contracts + async dispatcher" Foreground="{StaticResource TextSecondary}" FontSize="11.2"/><TextBlock Text="Core не зависит от WPF, Registry или P/Invoke." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" FontSize="11.2" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
            <!-- R32: persistent in-app startup update notification. It appears after the silent startup check and stays until user opens Updates or closes it. -->
        <Border Grid.Row="1" Grid.Column="1" Panel.ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Top" Width="430" Margin="0,9,12,0" Background="#123028" BorderBrush="#4ECAB3" BorderThickness="1.5" CornerRadius="10" Padding="11,8">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsStartupUpdateNoticeVisible}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Background="#1B493F" CornerRadius="15" VerticalAlignment="Top"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="#59D8C2" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="8,0,10,0"><TextBlock Text="ДОСТУПНО ОБНОВЛЕНИЕ" Foreground="#59D8C2" FontSize="9.4" FontWeight="Bold"/><TextBlock Text="{Binding StartupUpdateNoticeText, Mode=OneWay}" FontSize="11.3" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/><TextBlock Text="{Binding StartupUpdateNoticeDetailText, Mode=OneWay}" Foreground="#A9B7C4" FontSize="9.5" TextWrapping="Wrap" Margin="0,2,0,0"/><Button Style="{StaticResource CompactPrimaryButton}" Click="OpenUpdatesFromNotice_Click" Content="Открыть обновления" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
                <Button Grid.Column="2" Style="{StaticResource TableActionButton}" Command="{Binding DismissStartupUpdateNoticeCommand}" Content="×" Width="26" Height="25" FontSize="14" ToolTip="Скрыть уведомление"/>
            </Grid>
        </Border>
</Grid>
    <!-- R30: visual Update Center 4.0 retained in R31 -->
</Window>
