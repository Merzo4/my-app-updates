                                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding StandardProfileAvailableText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="9.9" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource CompactPrimaryButton}" Command="{Binding SelectStandardProfileCommand}" Content="Выбрать"/></Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Margin="0" Padding="10" CornerRadius="9">
                                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#141B24"/><Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsMaximumRecommended}" Value="True"><Setter Property="Background" Value="#112923"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                <StackPanel>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="MAXIMUM" FontSize="15" FontWeight="SemiBold"/><Border Grid.Column="1"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource RecommendationBadge}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMaximumRecommended}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="РЕКОМЕНДУЕТСЯ" Foreground="{StaticResource Accent}" FontSize="9.4" FontWeight="Bold"/></Border></Grid>
                                                    <TextBlock Text="Максимум без поломки системы" Foreground="#FF9AAA" FontSize="10.4" Margin="0,4,0,2"/>
                                                    <TextBlock Text="Всё из STANDARD + Privacy MAX: максимальные обратимые privacy-настройки, WER service/tasks и более глубокая оптимизация. Критические компоненты Windows сохраняются." Foreground="{StaticResource TextMuted}" FontSize="9.9" TextWrapping="Wrap" MinHeight="38"/>
                                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding MaximumProfileAvailableText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="9.9" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource CompactSecondaryButton}" Command="{Binding SelectMaximumProfileCommand}" Content="Выбрать"/></Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Border Background="#21171A" BorderBrush="#633642" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,7,0,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="18" Background="#351D24" Margin="0,0,9,0"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#FF9AAA" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="LITE BUILD" FontSize="12.8" FontWeight="SemiBold"/><Border Background="#351D24" BorderBrush="#6A3442" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="7,0,0,0"><TextBlock Text="ЭКСПЕРИМЕНТАЛЬНО" Foreground="#FF9AAA" FontSize="9.4" FontWeight="Bold"/></Border></StackPanel>
                                                    <TextBlock Text="MAXIMUM + дополнительные обратимые настройки фоновой активности и OneDrive через политику. Appx/debloat сканируется отдельно. Defender, Windows Update, Store, IPv6, SFC/DISM не удаляются и не ломаются." Foreground="{StaticResource TextSecondary}" FontSize="9.8" TextWrapping="Wrap" Margin="0,2,10,0"/>
                                                    <TextBlock Text="{Binding LiteBuildProfileAvailableText, Mode=OneWay}" Foreground="#FFB2BC" FontSize="9.7" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource CompactSecondaryButton}" Command="{Binding SelectLiteBuildProfileCommand}" Content="Открыть LITE BUILD" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#111A20" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="0,7,0,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedTweaksText, Mode=OneWay}" FontWeight="SemiBold" FontSize="10.7" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Style="{StaticResource CompactSecondaryButton}" Command="{Binding ClearTweakSelectionCommand}" Content="Снять выбор" Margin="0,0,6,0"/>
                                                <Button Grid.Column="2" Style="{StaticResource CompactPrimaryButton}" Command="{Binding ApplySelectedTweaksCommand}" Content="Перейти к применению"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="По одной" Style="{StaticResource SubTabItem}">
