                        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Результат проверки"/>
                                <TextBlock Text="Merzo учитывает то, что уже сделано вашей Windows или сборкой, и не предлагает повторять применённые изменения." Foreground="{StaticResource TextMuted}" FontSize="10.4"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource CompactSecondaryButton}" Command="{Binding RunRecoveryTestCommand}" Content="Проверить Undo" Margin="0,0,6,4"/>
                            <Button Grid.Column="2" Style="{StaticResource CompactPrimaryButton}" Command="{Binding RunDeepOptimizationScanCommand}" Content="Проверить снова" Margin="0,0,0,4"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#102A26" BorderBrush="#2B655A" BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,2,0,6">
