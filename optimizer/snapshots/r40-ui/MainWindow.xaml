                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding DeepScanSummaryText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="9.5" TextAlignment="Right" TextWrapping="Wrap" MaxWidth="210"/></StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedOptimizationTabIndex, Mode=TwoWay}">
