                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

            <!-- Optimization profiles -->
            <TabItem>
                <Grid Margin="11,8,11,9">
                    <!-- FIRST SCREEN: one clear scan action -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
