                                                        <Button Grid.Column="2" Style="{StaticResource TableActionButton}" Command="{Binding CleanCommand}" Content="Очистить" MinWidth="66" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Debloat Appx" Style="{StaticResource SubTabItem}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
