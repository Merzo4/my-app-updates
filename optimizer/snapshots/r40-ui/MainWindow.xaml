                                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="12.3" TextTrimming="CharacterEllipsis" MaxWidth="205"/>
                                                                <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="5,1" Margin="6,0,0,0"><TextBlock Text="{Binding SafetyText, Mode=OneWay}" Foreground="{StaticResource Accent}" FontSize="9.4" FontWeight="Bold"/></Border>
