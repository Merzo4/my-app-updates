<Window x:Class="MerzoOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Merzo Windows Optimizer — Production 0.1.33 · R33 STABILITY RECOVERY"
        Icon="Assets/MerzoWindowsOptimizer.ico"
        Width="1000" Height="600"
        MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Compact title bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="20" Height="20" Background="{StaticResource Accent}" CornerRadius="5" Margin="0,0,7,0">
                        <TextBlock Text="M" Foreground="#07110F" FontWeight="Bold" FontSize="11.8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Merzo Windows Optimizer" FontWeight="SemiBold" FontSize="12.8" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Production R40" Foreground="{StaticResource TextMuted}" FontSize="11.2" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0">
                    <Border Background="#12231F" BorderBrush="#21443C" BorderThickness="1" CornerRadius="10" Padding="7,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource Accent}" Margin="0,0,5,0"/>
                            <TextBlock Text="UNDO READY" Foreground="{StaticResource Accent}" FontSize="10.4" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Режим: " Foreground="{StaticResource TextMuted}" FontSize="11.2" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AdminText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="11.2" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="MaximizeRestore_Click"/>
                    <Button Style="{StaticResource CloseTitleBarButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dense navigation -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1,0">
            <DockPanel Margin="7,8,7,7">
                <Border DockPanel.Dock="Bottom" Background="#0F2721" BorderBrush="#1F4B40" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,5,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Защищённый режим" Foreground="{StaticResource Accent}" FontSize="11.2" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Snapshot + Undo · UAC по запросу" Foreground="{StaticResource TextMuted}" FontSize="10.4" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <StackPanel Margin="5,0,3,7">
                        <TextBlock Text="MERZO" Foreground="{StaticResource Accent}" FontSize="10.4" FontWeight="Bold"/>
                        <TextBlock Text="Windows Optimizer" FontSize="15" FontWeight="SemiBold" Margin="0,1,0,0"/>
                        <TextBlock Text="Production · v0.1.40" Foreground="{StaticResource TextMuted}" FontSize="10.4"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="ОСНОВНОЕ" Margin="6,0,0,3"/>
                    <RadioButton x:Name="DashboardNav" GroupName="MainNav" IsChecked="True" Style="{StaticResource NavRadioButton}" Click="Dashboard_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Главная" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AuditNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Audit_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Аудит системы" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TweaksNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Tweaks_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Оптимизация" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="StartupNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Startup_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Автозагрузка" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CleanupNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Cleanup_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Очистка / Debloat" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ServicesTasksNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="ServicesTasks_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Службы / задачи" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PowerNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Power_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Питание " FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="UpdatesNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Updates_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Обновления" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RestoreNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Restore_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Восстановление" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LogsNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Logs_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Журнал" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>

                    <TextBlock Style="{StaticResource Eyebrow}" Text="СЛЕДУЮЩИЕ ЭТАПЫ" Margin="6,9,0,3"/>
                    <RadioButton x:Name="GamingDevNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="GamingDev_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="21"/><TextBlock Text="Gaming / Developer" FontWeight="SemiBold"/></StackPanel>
                    </RadioButton>
                    <!-- R37_NETWORK_NAV_TEMPLATE <RadioButton x:Name="GamingDevNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="GamingDev_Click" Content="Gaming / Developer"/> -->
                    <RadioButton x:Name="NetworkNav" GroupName="MainNav" Style="{StaticResource NavRadioButton}" Click="Network_Click" Content="⌁  Repair / Network"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Grid.Column="1" Background="{StaticResource WindowBg}" BorderThickness="0" Padding="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style>
            </TabControl.ItemContainerStyle>

            <!-- Dashboard: designed to fit inside 1000x600 without page scrolling -->
            <TabItem>
                <Grid Margin="11,8,11,9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Обзор системы"/>
                            <TextBlock Text="Диагностика Windows · системные настройки не изменяются" Foreground="{StaticResource TextMuted}" FontSize="10.4" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RunAuditCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="12.8" Margin="0,0,6,0" Foreground="#EEF6F4"/>
                                <TextBlock Text="{Binding AuditButtonText, Mode=OneWay}" Foreground="#EEF6F4" FontSize="11.8"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#111A20" BorderBrush="#23443F" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,2,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" FontSize="12.8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11.2" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Margin="0,3,12,0" IsIndeterminate="{Binding IsBusy}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="READ ONLY" Foreground="{StaticResource Accent}" FontSize="10.4" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Eyebrow}" Text="SYSTEM HEALTH"/>
                                    <TextBlock Text="Общая оценка" FontSize="14" FontWeight="SemiBold" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Stroke="#2C3948" StrokeThickness="7"/>
                                    <Ellipse Stroke="{StaticResource Accent}" StrokeThickness="2" Margin="5" Opacity="0.85"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HealthScoreText, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Health Score" Foreground="{StaticResource TextMuted}" FontSize="10.4" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding HealthRatingText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11.8" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Не benchmark" Foreground="{StaticResource TextMuted}" FontSize="10.4" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Column="1" Columns="2" Rows="3">
                            <Border Style="{StaticResource CompactCardBorder}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="RAM"/><TextBlock Text="{Binding RamText, Mode=OneWay}" FontSize="12.8" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Accent}" Opacity="0.8"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CompactCardBorder}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="ПРОЦЕССЫ"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ProcessText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,1,5,0"/><TextBlock Text="{Binding ProcessDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="9.5" VerticalAlignment="Bottom" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/></StackPanel></StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CompactCardBorder}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="АВТОЗАГРУЗКА"/><TextBlock Text="{Binding StartupText, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CompactCardBorder}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="СИСТЕМНЫЙ ДИСК"/><TextBlock Text="{Binding StorageText, Mode=OneWay}" FontSize="12.8" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StorageDetailText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="10.4" Margin="0,1,0,0"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextMuted}"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CompactCardBorder}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="ПИТАНИЕ"/><TextBlock Text="{Binding PowerPlanText, Mode=OneWay}" FontSize="12.8" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#69A7EF"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CompactCardBorder}">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Style="{StaticResource Eyebrow}" Text="ПРОЦЕССОР"/><TextBlock Text="{Binding CpuText, Mode=OneWay}" FontSize="11.8" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" MaxHeight="28"/></StackPanel>
                                    <TextBlock Grid.Column="1" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Accent}"/>
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0" Padding="10">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Windows" FontSize="12.8" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource TextMuted}" FontSize="10.4"><Run Text="Аудит: "/><Run Text="{Binding LastAuditText, Mode=OneWay}"/></TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding WindowsText, Mode=OneWay}" FontSize="12.8" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding GpuText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="11.2" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                <Separator Margin="0,5,0,4"/>
                                <TextBlock Text="{Binding AuditFreshnessText, Mode=OneWay}" Foreground="{StaticResource Accent}" FontSize="10.2" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding AuditCatalogText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="9.7" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Проверено" FontSize="12.8" FontWeight="SemiBold"/>
                                <TextBlock Text="✓ Windows / build / права" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,4,0,0"/>
                                <TextBlock Text="✓ CPU / GPU / RAM / процессы" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,2,0,0"/>
                                <TextBlock Text="✓ Автозагрузка / диски / питание" Foreground="{StaticResource TextSecondary}" FontSize="10.4" Margin="0,2,0,0"/>
                                <TextBlock Text="Score: прозрачная базовая формула" Foreground="{StaticResource TextMuted}" FontSize="10.4" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Audit -->
            <TabItem>
                <Grid Margin="11,8,11,9">
                    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center"><TextBlock Style="{StaticResource PageTitle}" Text="Аудит системы"/><TextBlock Text="Подробности диагностики · только чтение" Foreground="{StaticResource TextMuted}" FontSize="11.2"/></StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding RunAuditCommand}" Content="Обновить данные" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#111A20" BorderBrush="#23443F" BorderThickness="1" CornerRadius="7" Padding="8,4" Margin="0,2,0,3">
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource TextSecondary}" FontSize="11.2" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
                        <TabItem Header="Автозагрузка" Style="{StaticResource SubTabItem}">
                            <DataGrid ItemsSource="{Binding StartupItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding Name, Mode=OneWay}" Width="135"/>
                                    <DataGridTextColumn Header="Источник" Binding="{Binding Source, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope, Mode=OneWay}" Width="65"/>
                                    <DataGridTextColumn Header="Команда / путь" Binding="{Binding Command, Mode=OneWay}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Процессы / Performance" Style="{StaticResource SubTabItem}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#101B22" BorderBrush="#2A4B54" BorderThickness="1" CornerRadius="8" Padding="9,6" Margin="0,0,0,5">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                                        <StackPanel><TextBlock Text="{Binding PerformanceProcessSummaryText, Mode=OneWay}" FontSize="10.8" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessReductionStatusText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="9.4" TextWrapping="Wrap"/></StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource CompactPrimaryButton}" Command="{Binding SelectProcessSafeCommand}" Click="OpenOptimization_Click" Content="SAFE" MinWidth="70" Margin="0,3,5,0" ToolTip="Фоновые источники с минимальным риском"/>
                                            <Button Style="{StaticResource CompactSecondaryButton}" Command="{Binding SelectProcessAggressiveCommand}" Click="OpenOptimization_Click" Content="AGGRESSIVE" MinWidth="92" Margin="0,3,5,0" ToolTip="Более глубокая разгрузка — проверьте функции перед применением"/>
                                            <Button Style="{StaticResource CompactSecondaryButton}" Command="{Binding SelectProcessLiteCommand}" Click="OpenOptimization_Click" Content="LITE-LIKE" MinWidth="82" Margin="0,3,0,0" ToolTip="Максимальная обратимая разгрузка без отключения Defender/Windows Update/IPv6/pagefile"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding TopProcesses}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Процесс" Binding="{Binding Name, Mode=OneWay}" Width="115"/>
                                        <DataGridTextColumn Header="RAM" Binding="{Binding WorkingSetHuman, Mode=OneWay}" Width="64"/>
                                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceHint, Mode=OneWay}" Width="185"/>
                                        <DataGridTextColumn Header="Режим" Binding="{Binding ReductionTier, Mode=OneWay}" Width="78"/>
                                        <DataGridTextColumn Header="Потенциал" Binding="{Binding ReductionPotential, Mode=OneWay}" Width="82"/>
                                        <DataGridTextColumn Header="Рекомендация" Binding="{Binding PerformanceAdvice, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId, Mode=OneWay}" Width="52"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Накопители" Style="{StaticResource SubTabItem}">
                            <DataGrid ItemsSource="{Binding StorageItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Диск" Binding="{Binding Name, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Тип" Binding="{Binding DriveType, Mode=OneWay}" Width="100"/>
                                    <DataGridTextColumn Header="FS" Binding="{Binding FileSystem, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Всего" Binding="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource BytesToHuman}}" Width="*"/>
                                    <DataGridTextColumn Header="Свободно" Binding="{Binding FreeBytes, Mode=OneWay, Converter={StaticResource BytesToHuman}}" Width="*"/>
                                    <DataGridTextColumn Header="Своб., %" Binding="{Binding FreePercent, Mode=OneWay, StringFormat={}{0:F1}%}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="Обратная связь" Style="{StaticResource SubTabItem}">
                            <Grid Margin="2,6,2,2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="#101B22" BorderBrush="#2A4B54" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
