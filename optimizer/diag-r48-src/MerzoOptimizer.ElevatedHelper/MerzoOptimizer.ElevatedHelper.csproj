<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MerzoOptimizer.ElevatedHelper</RootNamespace>
    <AssemblyName>MerzoOptimizer.ElevatedHelper</AssemblyName>
    <ApplicationManifest>helper.manifest</ApplicationManifest>
    <Version>0.1.48</Version>
    <AssemblyVersion>0.1.48.0</AssemblyVersion>
    <FileVersion>0.1.48.0</FileVersion>
    <Company>Merzo4</Company>
    <Product>Merzo Windows Optimizer Elevated Helper</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MerzoOptimizer.Core\MerzoOptimizer.Core.csproj" />
    <ProjectReference Include="..\MerzoOptimizer.Windows\MerzoOptimizer.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\data\**\*.*">
      <Link>data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- MERZO_R31_VERSION_BEGIN -->
  <PropertyGroup>
    <Version>0.1.48</Version>
    <VersionPrefix>0.1.48</VersionPrefix>
    <AssemblyVersion>0.1.48.0</AssemblyVersion>
    <FileVersion>0.1.48.0</FileVersion>
    <InformationalVersion>0.1.48</InformationalVersion>
  </PropertyGroup>
  <!-- MERZO_R31_VERSION_END -->
</Project>
